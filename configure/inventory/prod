# Launchpad public signup form (forms.avniproject.org) — its own dedicated
# node, deliberately NOT [metabase_server]: the web+service build runs npm ci
# and vite, and the reporting box already spikes to ~100% CPU during working
# hours next to a memory-sensitive Metabase JVM.
# i-08ea4a1c0da2befa1, t3.medium, ap-south-1b, sg launchpad-forms-sg.
# NOTE: this is an auto-assigned public IP, stable across reboots but NOT
# across a stop/start. The account is at its Elastic IP limit (10 of 15 are
# unassociated) — release one and attach it to make this durable.
[launchpad_forms_server]
13.233.115.61 ansible_user=ubuntu ansible_port=22 ansible_ssh_private_key_file=~/.ssh/openchs-infra.pem

# Hosts reached over AWS Session Manager: no inbound port 22 from the internet.
# ssm-ssh-proxy.sh opens the session; the key above (or CircleCI's throwaway key)
# still signs the SSH login. Run from configure/ so playbook_dir resolves.
[ssm_proxied:children]
webservers
avniservers
aiservers
etlservers

[ssm_proxied:vars]
ansible_ssh_common_args='-o ProxyCommand="{{ playbook_dir }}/scripts/ssm-ssh-proxy.sh {{ aws_instance_id }}" -o ServerAliveInterval=30'
