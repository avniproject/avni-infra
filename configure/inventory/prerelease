# Hosts reached over AWS Session Manager: no inbound port 22 from the internet.
# ssm-ssh-proxy.sh opens the session; the key above (or CircleCI's throwaway key)
# still signs the SSH login. Run from configure/ so playbook_dir resolves.
[ssm_proxied:children]
webservers
avniservers
aiservers
etlservers

[ssm_proxied:vars]
ansible_ssh_common_args='-o ProxyCommand="{{ playbook_dir }}/scripts/ssm-ssh-proxy.sh {{ aws_instance_id }}" -o ServerAliveInterval=30'
