.idea
*.iml
.terraform
# Both, not just the backup. This file ignored terraform.tfstate.backup and not
# terraform.tfstate itself, which is backwards -- state carries resource
# attributes and can carry secrets, the backup is a copy of the same. A stray
# `tofu` run outside provision/tofu/ (whose own .gitignore does cover this)
# drops one here, and it was committable.
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*
*.pem
*.png
# Allow branding assets baked into Docker images
!reportingSystem/tanuh-metabase/assets/*.png
.DS_Store
provision/user-management/users.json
provision/server/*override.tf
cognito-users-mapped.json
node_modules
provision/user-management/cognito-users.json
provision/user-management/openchs-users.json
vars/*.tfvars
prod-user-pool.json
*-secret-vars.yml
/configure/certificates/**
/configure/dummy.yml
/reportingSystem/superset/superset.env
/local/keycloak/On-premise-realm.json
